<?xml version="1.0" encoding="UTF-8"?>
<EXPERIMENT_SET>
  <EXPERIMENT alias="s1-amp" center_name="Nowhere Lab">
    <TITLE>test gene amplicon of s1</TITLE>
    <STUDY_REF refname="fixture-study"/>
    <DESIGN>
      <DESIGN_DESCRIPTION>test gene R1 amplicon, pF/pR, paired-end, test kit</DESIGN_DESCRIPTION>
      <SAMPLE_DESCRIPTOR refname="s1"/>
      <LIBRARY_DESCRIPTOR>
        <LIBRARY_NAME>s1-amp</LIBRARY_NAME>
        <LIBRARY_STRATEGY>AMPLICON</LIBRARY_STRATEGY>
        <LIBRARY_SOURCE>METAGENOMIC</LIBRARY_SOURCE>
        <LIBRARY_SELECTION>PCR</LIBRARY_SELECTION>
        <LIBRARY_LAYOUT>
          <PAIRED NOMINAL_LENGTH="100"/>
        </LIBRARY_LAYOUT>
        <LIBRARY_CONSTRUCTION_PROTOCOL>test protocol Primers: pF (GGTTAACC) / pR (CCAATTGG). Target: test gene R1. Reads are as delivered, with primer sequences retained.</LIBRARY_CONSTRUCTION_PROTOCOL>
      </LIBRARY_DESCRIPTOR>
    </DESIGN>
    <PLATFORM>
      <ILLUMINA>
        <INSTRUMENT_MODEL>Illumina MiSeq</INSTRUMENT_MODEL>
      </ILLUMINA>
    </PLATFORM>
  </EXPERIMENT>
