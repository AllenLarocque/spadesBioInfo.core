<?xml version="1.0" encoding="UTF-8"?>
<CHECKLIST_SET>
  <CHECKLIST accession="ERC999999" checklistType="Sample">
    <IDENTIFIERS><PRIMARY_ID>ERC999999</PRIMARY_ID></IDENTIFIERS>
    <DESCRIPTOR>
      <LABEL>mini test checklist</LABEL>
      <NAME>mini test checklist</NAME>
      <FIELD_GROUP restrictionType="Any number or none of the fields">
        <NAME>test group</NAME>
        <FIELD>
          <LABEL>collection date</LABEL>
          <NAME>collection_date</NAME>
          <FIELD_TYPE><TEXT_FIELD><REGEX_VALUE>(^[12][0-9]{3}-[0-9]{2}-[0-9]{2}$)|(^not provided$)</REGEX_VALUE></TEXT_FIELD></FIELD_TYPE>
          <MANDATORY>mandatory</MANDATORY>
          <MULTIPLICITY>single</MULTIPLICITY>
        </FIELD>
        <FIELD>
          <LABEL>geographic location (country and/or sea)</LABEL>
          <NAME>geographic location (country and/or sea)</NAME>
          <FIELD_TYPE><TEXT_CHOICE_FIELD>
            <TEXT_VALUE><VALUE>Canada</VALUE></TEXT_VALUE>
            <TEXT_VALUE><VALUE>Norway</VALUE></TEXT_VALUE>
          </TEXT_CHOICE_FIELD></FIELD_TYPE>
          <MANDATORY>mandatory</MANDATORY>
          <MULTIPLICITY>single</MULTIPLICITY>
        </FIELD>
        <FIELD>
          <LABEL>depth</LABEL>
          <NAME>depth</NAME>
          <FIELD_TYPE><TEXT_FIELD><REGEX_VALUE>(0|((0\.)|([1-9][0-9]*\.?))[0-9]*)([Ee][+-]?[0-9]+)?</REGEX_VALUE></TEXT_FIELD></FIELD_TYPE>
          <UNITS><UNIT>m</UNIT><UNIT>mm</UNIT></UNITS>
          <MANDATORY>mandatory</MANDATORY>
          <MULTIPLICITY>single</MULTIPLICITY>
        </FIELD>
        <FIELD>
          <LABEL>sample collection device</LABEL>
          <NAME>sample collection device</NAME>
          <FIELD_TYPE><TEXT_FIELD/></FIELD_TYPE>
          <MANDATORY>optional</MANDATORY>
          <MULTIPLICITY>single</MULTIPLICITY>
        </FIELD>
        <FIELD>
          <LABEL>sample collection method</LABEL>
          <NAME>sample_collection_method</NAME>
          <FIELD_TYPE><TEXT_FIELD/></FIELD_TYPE>
          <MANDATORY>optional</MANDATORY>
          <MULTIPLICITY>single</MULTIPLICITY>
        </FIELD>
      </FIELD_GROUP>
    </DESCRIPTOR>
  </CHECKLIST>
</CHECKLIST_SET>
